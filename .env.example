# Copy this file to .env and fill in the two IBKR values.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# Local, zero-maintenance database. Relative paths are resolved from this folder.
DATABASE_PATH=data/portfolio.db
DATABASE_URL=
PORTFOLIO_TENANT_ID=00000000-0000-0000-0000-000000000001
PORTFOLIO_TENANT_NAME=Own Portfolio
RAW_REPORT_DIR=raw/flex
LOG_DIR=logs
PORTFOLIO_TIMEZONE=Asia/Hong_Kong

# The nightly loader deliberately overlaps recent dates to capture corrections.
DAILY_LOOKBACK_DAYS=7
FLEX_USER_AGENT=IBKR-Portfolio-ETL/1.0
FLEX_REQUEST_TIMEOUT_SECONDS=60
FLEX_MAX_WAIT_SECONDS=300
FLEX_MIN_SEND_INTERVAL_SECONDS=10
FLEX_TRANSIENT_COOLDOWN_SECONDS=1800
AZURE_STORAGE_ACCOUNT_URL=
AZURE_RAW_CONTAINER=ibkr-raw
AZURE_REPORT_CONTAINER=ibkr-reports

# Monday 21:00 Hong Kong time: the owner approves the IB Key push then. The
# Monday 20:30 patch window comes first, so a patch reboot lands before it.
[Unit]
Description=Monday 21:00 Hong Kong time: weekly IB Gateway fresh login

[Timer]
OnCalendar=Mon *-*-* 21:00:00 Asia/Hong_Kong
AccuracySec=1s
# A missed run is not caught up: a boot starts the gateway (and a login) anyway.
Persistent=false
Unit=ibkr-gateway-weekly-relogin.service

[Install]
WantedBy=timers.target

# RESEARCH ONLY: the research job (scripts/research/run_research_job.py, infra/research.bicep).
# Never use this image for the website, the agents, the daily jobs or document rendering.
# It adds scipy and pyarrow (requirements-research.lock); no other image has them.
# Built from a source-only context by scripts/research/release_research_image.py (see
# scripts/research/RELEASE.md); the base and its security fixes are the risk image's.
FROM python:3.12-slim@sha256:44ff437bba879d4941b710a369a8f19266aea34b29002807f0c487fabc9eec9b
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    IBKR_PROJECT_ROOT=/app PYTHONPATH=/app/src
WORKDIR /app
# Verified stable-distribution security fixes, as in Dockerfile.risk. Keep versions explicit
# and fail the build if signed repositories cannot provide them.
RUN apt-get update && \
    apt-get install --yes --no-install-recommends --only-upgrade \
        libpcre2-8-0=10.46-1~deb13u3 \
        libssl3t64=3.5.7-1~deb13u3 \
        openssl=3.5.7-1~deb13u3 \
        openssl-provider-legacy=3.5.7-1~deb13u3 && \
    dpkg-query --show libpcre2-8-0 libssl3t64 openssl openssl-provider-legacy && \
    rm -rf /var/lib/apt/lists/*
COPY requirements-research.lock ./
# Wheels only, every one checked against its hash.
RUN python -m pip install --no-cache-dir --require-hashes --only-binary=:all: -r requirements-research.lock && \
    python -m pip check
COPY src ./src
COPY scripts/research ./scripts/research
COPY SOURCE_MANIFEST.json ./
RUN groupadd --gid 10001 ibkr && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin ibkr
USER 10001:10001
RUN python scripts/research/check_research_image.py
CMD ["python", "scripts/research/run_research_job.py", "check"]

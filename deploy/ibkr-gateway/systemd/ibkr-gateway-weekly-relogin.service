# Weekly fresh IB Gateway login. See /opt/ibkr-live/relogin-check.sh.
[Unit]
Description=Weekly IB Gateway fresh login (one IB Key push)
# Do nothing unless the gateway stack is up.
Requisite=ibkr-live.service
After=ibkr-live.service

[Service]
Type=oneshot
Environment=DOCKER_CONFIG=/run/ibkr-docker
ExecStart=/opt/ibkr-live/relogin-check.sh weekly

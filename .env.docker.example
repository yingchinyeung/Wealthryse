# Copy to .docker.env. Never commit .docker.env.
POSTGRES_DB=ibkr
POSTGRES_USER=ibkr_admin
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432

PORTFOLIO_TENANT_ID=00000000-0000-0000-0000-000000000001
PORTFOLIO_TENANT_NAME=Own Portfolio

# Only needed when running the ETL container locally.
IBKR_FLEX_QUERY_ID=
IBKR_FLEX_TOKEN=
FLEX_MIN_SEND_INTERVAL_SECONDS=10
FLEX_TRANSIENT_COOLDOWN_SECONDS=1800

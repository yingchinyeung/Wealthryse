FROM python:3.12-slim
# LIVE COLLECTOR ONLY. Runs on the IB Gateway VM next to the gateway container
# and talks to it over the private Docker network; it publishes no ports.
# The collector is read-only: it connects with readonly=True and never places
# or cancels orders.

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    IBKR_PROJECT_ROOT=/app

WORKDIR /app

RUN groupadd --gid 10001 ibkr && \
    useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin ibkr

COPY pyproject.toml requirements.lock requirements-live.lock ./
COPY src ./src

RUN python -m pip install --require-hashes -r requirements.lock -r requirements-live.lock && \
    python -m pip install --no-deps . && \
    python -c "import ib_async, ibkr_etl.live_collector"

USER 10001:10001

CMD ["python", "-m", "ibkr_etl.live_collector"]

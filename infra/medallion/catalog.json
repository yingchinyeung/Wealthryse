{
 "about": "Medallion layer for every database table and view, blob container and job. tests/test_medallion_catalog.py fails when a migration adds a table or view, or Bicep adds a container, without an entry here. See docs/MEDALLION_ARCHITECTURE.md.",
 "version": 1,
 "layers": {
  "bronze": "Raw data exactly as received from IBKR, market-data providers and people's uploads. Append-only, never edited; corrections happen in silver.",
  "silver": "Cleaned, validated and conformed records: accounts, securities, trades, positions, cash, NAV, FX, benchmarks and derived portfolios. Rebuildable from bronze.",
  "gold": "Reporting-ready analytics and frozen report payloads that feed the factsheets, decks, website and agents.",
  "ops": "Control plane, not a data layer: runs, approvals, audit, access, onboarding workflow, agent state and configuration. Stays in public.",
  "platform": "Database plumbing that stays in public: tenants, the migration ledger and the row-level-security helpers."
 },
 "hops": {
  "ingest": "Source to bronze.",
  "conform": "Bronze to silver.",
  "analytics": "Silver to gold.",
  "quality-gate": "Checks between layers; blocks promotion on failure.",
  "publish": "Gold to rendered files and releases.",
  "serve": "Gold and silver to the website and agents.",
  "ops": "Control plane."
 },

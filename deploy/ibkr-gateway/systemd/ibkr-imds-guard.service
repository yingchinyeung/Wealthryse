# Block containers from the instance metadata endpoint before Docker starts.
# docker.service requires this unit (drop-in docker.service.d/10-ibkr-imds-guard.conf),
# so even a container Docker restarts on its own at boot is already blocked.
# The VM identity behind that endpoint can read the IBKR login secrets.
[Unit]
Description=Block Docker containers from the instance metadata endpoint
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/ibkr-live/imds-guard.sh

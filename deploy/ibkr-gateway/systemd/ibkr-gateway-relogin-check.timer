# Every 30 minutes from 08:00 to 23:00 Hong Kong time. relogin-check.sh also
# checks the window itself and does nothing outside it.
[Unit]
Description=Every 30 minutes, 08:00-23:00 Hong Kong time: IB Gateway re-login check

[Timer]
OnCalendar=*-*-* 08..22:00,30:00 Asia/Hong_Kong
OnCalendar=*-*-* 23:00:00 Asia/Hong_Kong
AccuracySec=1s
Persistent=false
Unit=ibkr-gateway-relogin-check.service

[Install]
WantedBy=timers.target

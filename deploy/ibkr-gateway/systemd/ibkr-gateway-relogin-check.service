# Re-login check after the owner signs in elsewhere. See /opt/ibkr-live/relogin-check.sh.
[Unit]
Description=IB Gateway re-login check (restart after 10 minutes disconnected)
# Do nothing unless the gateway stack is up.
Requisite=ibkr-live.service
After=ibkr-live.service

[Service]
Type=oneshot
Environment=DOCKER_CONFIG=/run/ibkr-docker
ExecStart=/opt/ibkr-live/relogin-check.sh check
